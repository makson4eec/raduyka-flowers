# Администратор магазина
ADMIN_PASSWORD=
# В production используйте пароль не короче 16 символов.
ADMIN_SESSION_SECRET=
# В production: отдельный случайный секрет не короче 32 символов.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Альтернатива для новых Supabase-ключей (достаточно одной из двух строк):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# Firebase Web App: публичная конфигурация браузера
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-app-id>
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<public-web-push-vapid-key>

# Firebase Admin SDK: только сервер, никогда не добавляйте NEXT_PUBLIC_
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<service-account-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Cron/Vercel
CRON_SECRET=
# Используйте случайное значение длиной минимум 16 символов.
REMINDER_TIME_ZONE=Asia/Yekaterinburg

# Канонический HTTPS-адрес production-сайта.
# Пока домен не подключён, Vercel deployment может использовать свой системный
# production URL. После подключения домена лучше явно задать SITE_URL.
SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
DEPLOYMENT_HTTPS_ONLY=
